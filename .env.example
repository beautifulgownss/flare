# Data providers
HUNTER_API_KEY=
SERPER_API_KEY=

# Pitch pages (optional step)
ANTHROPIC_API_KEY=
# Model and its current list price in USD per million tokens. Run cost is
# calculated from actual token usage at these rates.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_INPUT_COST_PER_MTOK=3
ANTHROPIC_OUTPUT_COST_PER_MTOK=15

# CRM sync (optional step)
HUBSPOT_SERVICE_KEY=

# Score-change alerts: Slack first, email as a fallback
SLACK_WEBHOOK_URL=
ALERT_EMAIL_SENDER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_RECIPIENT=
